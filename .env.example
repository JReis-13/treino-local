# Server-side Google OAuth credentials. Set in .env.local or Vercel Environment Variables.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate at least 32 random bytes, encoded as base64url/hex (43+ characters).
GOOGLE_OAUTH_SESSION_SECRET=
# Exactly http://localhost:3000 for local dev or https://treino-local.vercel.app in production.
APP_BASE_URL=http://localhost:3000
# For a physical phone on local Wi-Fi, TREINO_LAN_HOST may select the PC's private IPv4 address.
